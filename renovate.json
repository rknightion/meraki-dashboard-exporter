{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "pre-commit": {
    "enabled": true
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update tool version assignments in the justfile",
      "fileMatch": ["/^justfile$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[^\\s]+) depName=(?<depName>[^\\s]+)\\s*\\n[a-z_]+_version := \"(?<currentValue>[^\"]+)\""
      ]
    },
    {
      "customType": "regex",
      "description": "Update git commit pins in the justfile",
      "fileMatch": ["/^justfile$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>git-refs) depName=(?<depName>[^\\s]+) currentValue=(?<currentValue>[^\\s]+)\\s*\\n[a-z_]+_rev := \"(?<currentDigest>[a-f0-9]{40})\""
      ]
    }
  ],
  "packageRules": [
    {
      "description": "Rebase GitHub Actions PRs only when conflicted (override the fleet default)",
      "matchManagers": ["github-actions"],
      "rebaseWhen": "conflicted"
    },
    {
      "description": "Track OpenTelemetry pre-release versions",
      "ignoreUnstable": false,
      "labels": ["dep:opentelemetry"],
      "matchPackageNames": ["/^opentelemetry/"]
    },
    {
      "description": "OpenTelemetry Python packages (api, sdk, exporter-otlp, instrumentation-*) release in lockstep — group them into one PR.",
      "matchPackageNames": ["/^opentelemetry/"],
      "groupName": "opentelemetry"
    }
  ]
}
